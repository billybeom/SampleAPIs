# /etc/systemd/system/library-api.service
#
# 설치 위치: /etc/systemd/system/library-api.service
# 애플리케이션 경로: /opt/sample-apis/api1-library
#
# 활성화:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now library-api
#
[Unit]
Description=Library Management REST API (Node.js)
Documentation=https://github.com/your-org/sample-apis
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=svcapi
Group=svcapi
WorkingDirectory=/opt/sample-apis/api1-library

# 환경변수 파일 (파일이 없어도 서비스는 기동됨)
EnvironmentFile=-/etc/sample-apis/library-api.env

# 시작 명령
ExecStart=/usr/bin/node src/index.js

# 재시작 정책
Restart=on-failure
RestartSec=5s

# 로깅 — journald로 수집 (journalctl -u library-api -f)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=library-api

# 보안 강화 옵션
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/tmp

[Install]
WantedBy=multi-user.target
