# /etc/sample-apis/salary-api.env
#
# Salary API 환경변수 파일 — Keycloak 외부 IdP 연동
# ⚠️  이 파일을 아래 권한으로 보호하세요:
#       sudo chown root:svcapi /etc/sample-apis/salary-api.env
#       sudo chmod 640 /etc/sample-apis/salary-api.env
#
# ── 필수 설정 (Keycloak 환경에 맞게 변경) ────────────────────────────────────
#
# Keycloak 서버 URL (예: http://192.168.1.100:8080 또는 https://keycloak.corp.com)
KEYCLOAK_URL=http://keycloak.example.com

# Keycloak Realm 이름
KEYCLOAK_REALM=corp

# ── 선택 설정 ─────────────────────────────────────────────────────────────────
#
# 토큰의 aud 클레임 검증값 (Keycloak Client ID와 일치해야 함)
# Keycloak Client에서 'salary-api' 라는 이름의 Client를 생성하세요.
KEYCLOAK_AUDIENCE=salary-api

# API Connect가 토큰을 전달하는 헤더 이름
# - 기본값(Authorization): API Connect가 토큰을 Authorization 헤더 그대로 전달
# - 커스텀(예: X-Forwarded-Access-Token): API Connect Set-Variable 정책으로
#   별도 헤더에 토큰을 복사하는 경우
TOKEN_HEADER_NAME=Authorization

# ── 런타임 설정 ───────────────────────────────────────────────────────────────
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
